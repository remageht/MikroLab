<Project>

  <PropertyGroup>
    <Version>1.1.2</Version>
    <AssemblyVersion>1.1.2.0</AssemblyVersion>
    <FileVersion>1.1.2.0</FileVersion>
    <InformationalVersion>1.1.2</InformationalVersion>
    <Product>MikroLab</Product>
    <Company>MikroLab</Company>
    <Authors>MikroLab contributors</Authors>
    <Copyright>GPL-3.0-or-later</Copyright>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/remageht/MikroLab</RepositoryUrl>
    <!-- The UI is Russian; keep English as the framework fallback. -->
    <SatelliteResourceLanguages>en;ru</SatelliteResourceLanguages>
  </PropertyGroup>

</Project>
