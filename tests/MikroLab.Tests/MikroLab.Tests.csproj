<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>MikroLab.Tests</RootNamespace>
    <AssemblyName>MikroLab.Tests</AssemblyName>
    <NuGetAudit>false</NuGetAudit>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\MikroLab.Core\MikroLab.Core.csproj" />
    <ProjectReference Include="..\..\src\MikroLab.Presentation\MikroLab.Presentation.csproj" />
  </ItemGroup>

  <Target Name="VSTest">
    <Exec Command="&quot;$(TargetPath)&quot;" />
  </Target>

</Project>
