<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>MikroLab.Studio</RootNamespace>
    <AssemblyName>MikroLab</AssemblyName>
    <LangVersion>latest</LangVersion>
    <NuGetAudit>false</NuGetAudit>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MikroLab.Core\MikroLab.Core.csproj" />
    <ProjectReference Include="..\MikroLab.Presentation\MikroLab.Presentation.csproj" />
  </ItemGroup>

</Project>
