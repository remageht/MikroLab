<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>MikroLab.Cli</RootNamespace>
    <AssemblyName>MikroLab.Cli</AssemblyName>
    <LangVersion>latest</LangVersion>
    <NuGetAudit>false</NuGetAudit>
    <!-- The CLI is trim-safe: JSON uses a source-generated serializer context. -->
    <PublishTrimmed Condition="'$(RuntimeIdentifier)' != ''">true</PublishTrimmed>
    <TrimMode Condition="'$(RuntimeIdentifier)' != ''">full</TrimMode>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\MikroLab.Core\MikroLab.Core.csproj" />
  </ItemGroup>

</Project>
